/* DM Dataset specification According to RSD
   From QC_ADSL (1).sas — DM derivation: SEXN, USUBJID/ARM length
   reassignment via INPUT, and the REGION country-mapping logic.
   The external LIBNAME Rawdata.DM is replaced by a small inline mock DM
   (datalines) matching the SDTM column shape the script reads, so this
   file is self-contained; the derivation logic below is the author's. */
DATA DM;
	length STUDYID $20 USUBJID $30 SUBJID $20 SITEID $20 SEX $1 RACE $50
	       COUNTRY $8 ARM $50 ARMCD $20 RFSTDTC $10 RFENDTC $10;
	input STUDYID $ USUBJID $ SUBJID $ SITEID $ AGE SEX $ RACE $ COUNTRY $
	      ARM $ ARMCD $ RFSTDTC $ RFENDTC $;
	AGEU = "YEARS";
datalines;
CYT001 CYT001-USA-001 001 USA-01 54 M WHITE USA PLACEBO PLAC 2014-01-02 2014-06-30
CYT001 CYT001-CAN-002 002 CAN-01 61 F WHITE CAN CYT001_3MG CYT0013 2014-02-11 2014-08-01
CYT001 CYT001-GBR-003 003 GBR-01 47 M BLACK GBR CYT001_10MG CYT00110 2014-03-05 2014-09-10
CYT001 CYT001-DEU-004 004 DEU-01 39 F ASIAN DEU PLACEBO PLAC 2014-01-20 2014-07-15
CYT001 CYT001-CHN-005 005 CHN-01 58 M ASIAN CHN CYT001_10MG CYT00110 2014-04-01 2014-10-01
CYT001 CYT001-ARG-006 006 ARG-01 66 F WHITE ARG CYT001_3MG CYT0013 2014-02-28 2014-08-30
CYT001 CYT001-ZAF-007 007 ZAF-01 52 M BLACK ZAF PLACEBO PLAC 2014-03-12 2014-09-20
CYT001 CYT001-RUS-008 008 RUS-01 45 F WHITE RUS CYT001_10MG CYT00110 2014-01-15 2014-07-30
CYT001 CYT001-AUS-009 009 AUS-01 60 M ASIAN AUS CYT001_3MG CYT0013 2014-02-05 2014-08-12
CYT001 CYT001-ESP-010 010 ESP-01 71 F WHITE ESP PLACEBO PLAC 2014-03-22 2014-10-05
;
run;

DATA DM_ADSL (DROP=USUBJID ARM);
	RENAME uniq=USUBJID;
	LENGTH STUDYID $20 Uniq $20 SUBJID $20 SITEID $20 AGE 8. AGEU $15 SEX $1 SEXN 8. RACE $50
	COUNTRY $8. REGION $20 Arml $50. ARMCD $20.;
	FORMAT Age 8. Ageu $15. SEXN 8.;
	SET DM;
	/*Specifying SEXN, reassignig length to USUBJID and ARM*/
	RENAME uniq=USUBJID	Arml=ARM;
	Uniq=INPUT(USUBJID,$20.);
	Arml=INPUT(ARM,$50.);
	/*Specifying SEXN*/
	IF Sex="M" THEN SEXN=1;
	IF Sex="F" THEN SEXN=2;
	/*Specifying Country*/
	IF country in('CAN','USA') THEN region='NORTH AMERICA';
	ELSE IF  country in ('AUT','BEL','DNK','ITA','NLD','NOR','SWE','FRA','ISR','ESP') THEN region='WESTERN EUROPE';
	ELSE IF country in ('BLR','BGR','HUN','POL','ROU','RUS','SVK','UKR','TUR') THEN region='EASTERN EUROPE';
	ELSE IF country in ('DEU','HRV','SCG') THEN region='CENTRAL EUROPE';
	ELSE IF country in ('AUS','CHN','HKG','IND','MYS','SGP','TWN','THA') THEN region='ASIA';
	ELSE IF country in ('ARG','CHL','COL','MEX','PER') THEN region='LATIN AMERICA';
	ELSE IF country='ZAF' THEN region='SOUTHERN AFRICA';
	ELSE IF country='GBR' THEN region='NORTHERN EUROPE';
	FORMAT Age 8. Ageu $15. SEXN 8.;
RUN;

PROC FREQ DATA=DM_ADSL;
	TABLES region / NOCUM;
	TITLE "ADSL DM derivation — REGION distribution";
RUN;

PROC PRINT DATA=DM_ADSL (OBS=10);
	VAR USUBJID SEX SEXN COUNTRY REGION;
	TITLE "ADSL DM derivation — subject-level REGION / SEXN";
RUN;
